# Docker Compose ------------------------------------------------------------

# Where to publish the app. One port serves the frontend, the API and the
# superuser dashboard at /_/. Loopback by default: put a TLS-terminating
# reverse proxy in front of it rather than changing this to 0.0.0.0, and
# restrict the dashboard with `superuser ips` before it is reachable at all.
# WEB_PUBLISH=127.0.0.1:8090

# Must match the owner of ./pb_data on the host (`id -u` and `id -g`).
# PUID=1000
# PGID=1000

# Local development ---------------------------------------------------------

# Makes a bare `docker compose up -d` run the hot-reloading dev stack rather
# than the production one, so edits show up without rebuilding an image. Leave
# it commented out anywhere you actually deploy from: it applies to every
# compose command run in this directory, including a production one.
# COMPOSE_FILE=compose.dev.yaml

# Where `npm run dev` proxies /api. Only change this if PocketBase is not on
# the default port.
# PB_PROXY_TARGET=http://127.0.0.1:8091

# The app talks to PocketBase over its own origin by default — the same server
# serves both. Set this only if you host the API on a separate domain, in which
# case you must also configure CORS in the PocketBase dashboard.
# VITE_POCKETBASE_URL=https://api.example.com
